# Copy this file to .env and fill in real values. .env is gitignored — never commit secrets.

# --- PostgreSQL (docker-compose "db" service) ---
POSTGRES_DB=therapify
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

# --- Spring datasource (docker-compose "app" service) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/therapify
SPRING_DATASOURCE_USERNAME=changeme
SPRING_DATASOURCE_PASSWORD=changeme
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# --- Mail (Gmail SMTP) — use a Gmail App Password, not your account password ---
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=changeme@gmail.com
SPRING_MAIL_PASSWORD=changeme
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# --- Demo accounts (see DemoService) ---
THERAPIFY_DEMO_DOCTOR_EMAIL=demo.terapeuta@therapify.com
THERAPIFY_DEMO_PATIENT_EMAIL=demo.paciente@therapify.com
